# ==============================================================================
# GARROTEROS MONOREPO - MODO DE EJECUCIÓN (APP_MODE)
# Opciones disponibles: 'local' | 'render'
# Cambia esta variable a 'render' para compilar la APK o desplegar hacia Render,
# o a 'local' para desarrollar en tu máquina con Docker/Postgres local.
# ==============================================================================
APP_MODE=local

# ==============================================================================
# 1. PARÁMETROS PARA DESPLIEGUE EN RENDER (NUBE / PRODUCCIÓN)
# ==============================================================================
# URL pública de tu backend NestJS desplegado en Render (HTTPS)
RENDER_BACKEND_URL=https://garroterosapp-backend.onrender.com

# URL de la base de datos PostgreSQL en Render (Internal o External Database URL)
# Ejemplo: postgresql://tour_admin:password@dpg-xxxxx.oregon-postgres.render.com/guianza_turistica_db
RENDER_DATABASE_URL=postgresql://your_user:your_password@dpg-sample.oregon-postgres.render.com/guianza_turistica_db
RENDER_DATABASE_SSL=true

# URL de Redis en la nube (Upstash / Redis Cloud / Render Redis)
# Ejemplo: rediss://default:password@xxxxx.upstash.io:6379
RENDER_REDIS_URL=rediss://default:your_token@sample.upstash.io:6379

# ==============================================================================
# 2. PARÁMETROS PARA DESARROLLO LOCAL (TU MÁQUINA + DOCKER)
# ==============================================================================
LOCAL_BACKEND_PORT=3000
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=tour_admin
LOCAL_DB_PASSWORD=your_secure_local_password
LOCAL_DB_NAME=guianza_turistica_db
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379

# IP LAN para pruebas de la APK física en la misma red Wi-Fi (dejar vacía para auto-detectar)
LOCAL_LAN_IP=

# ==============================================================================
# 3. SEGURIDAD Y TOKENS (COMPARTIDO)
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION=24h
CORS_ORIGIN=http://localhost:8100,http://localhost:4200,capacitor://localhost,https://localhost,http://localhost
